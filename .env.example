# Put these in Bot-Hosting's environment variables (or copy this file to .env for local runs).
# Never upload a filled .env or your token to GitHub.

# --- Required ---
DISCORD_TOKEN=

# --- Strongly recommended: your server ID. Commands then appear instantly. ---
GUILD_ID=

# --- Optional ---
# Extra servers the bot may stay in (comma separated). It leaves every server that is not
# GUILD_ID or listed here, the moment it is added.
# ALLOWED_GUILDS=
BOT_NAME=dor
# Text-command prefix, e.g. !play (slash commands like /play always work too)
BOT_PREFIX=!
EMBED_COLOR=0x5865F2
# DATA_DIR=./data
